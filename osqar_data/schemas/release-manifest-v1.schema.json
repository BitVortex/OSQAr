{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osqar.dev/schemas/release-manifest-v1.schema.json",
  "title": "OSQAr closed release manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "manifest_version", "release_version", "source_revision", "producer", "exclusions", "artifacts"],
  "properties": {
    "schema": {"const": "osqar.release-manifest.v1"},
    "manifest_version": {"const": 1},
    "release_version": {
      "type": "string",
      "pattern": "^v[0-9]+(?:\\.[0-9]+)*(?:(?:a|b|rc)[0-9]+)?(?:\\.post[0-9]+)?(?:\\.dev[0-9]+)?(?:\\+[a-z0-9]+(?:[._-][a-z0-9]+)*)?$"
    },
    "source_revision": {"type": "string", "pattern": "^(?:[0-9A-Fa-f]{40}|[0-9A-Fa-f]{64})$"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "tool", "version"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "tool": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "exclusions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "required", "size", "sha256", "producer_command"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "size": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
          "producer_command": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
